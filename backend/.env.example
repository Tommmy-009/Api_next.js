# Copy to backend/.env and replace every placeholder.
DATABASE_URL=postgresql://upnext_user:change-me@localhost:5432/upnext
JWT_SECRET_KEY=replace-with-a-long-random-secret
ARGO_CREDENTIALS_KEY=replace-with-a-separate-fernet-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ARGO_SCRAPE_TIMEOUT_SECONDS=120
CORS_ORIGINS=http://localhost:3000
DEBUG_SCRAPER=false

# Required by docker compose when using its local PostgreSQL service.
POSTGRES_PASSWORD=change-me
# Optional admin dashboard credentials.
# ADMIN_DASHBOARD_USERNAME=admin
# ADMIN_DASHBOARD_PASSWORD=change-me
